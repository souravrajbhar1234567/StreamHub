# ==========================================
# StreamHub - Full Stack Environment Variables
# ==========================================

# -----------------
# Backend Config
# -----------------
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Storage
# Use local MongoDB or MongoDB Atlas URI:
MONGO_URI=mongodb://localhost:27017/streamhub
# Redis URL (Optional - in-memory fallback enabled if empty or unavailable)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=streamhub_super_secret_jwt_encryption_key_2026_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=streamhub_super_secret_refresh_token_key_2026_production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Razorpay Payment Gateway (Test or Live keys)
RAZORPAY_KEY_ID=rzp_test_StreamHubKey123
RAZORPAY_KEY_SECRET=streamhub_razorpay_secret_test_key_123

# Cloudinary Storage (Optional - local fallback supported)
CLOUDINARY_CLOUD_NAME=streamhub-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz1234

# Email Service (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=streamhub_mailer
SMTP_PASS=streamhub_mail_password
EMAIL_FROM=support@streamhub.com

# -----------------
# Frontend Config (Vite)
# -----------------
VITE_API_URL=http://localhost:5001/api/v1
VITE_SOCKET_URL=http://localhost:5001
VITE_RAZORPAY_KEY_ID=rzp_test_StreamHubKey123
